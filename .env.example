# ============================================================================
# .env.example —— 自建密码箱配置模板
#
# 用法：cp .env.example .env   然后按下面每条中文注释逐项修改
#
# 取值规则：等号两边不要加空格；值里不要出现空格（如需空格请用双引号包住）
#
# 安全提醒：
#   * .env 文件含有服务器配置，绝不能提交到 Git（.gitignore 已排除它）
#   * 本模板不含任何真实密钥
# ============================================================================

# ---------- Vaultwarden 基本 ----------

# 服务器对外地址。setup.sh 会自动把你的 ts.net 地址填进来；
# 如果手动修改，必须以 https:// 开头，且与 tailscale serve 的域名完全一致
DOMAIN=https://your-machine.your-tailnet.ts.net

# Vaultwarden 版本号：固定写死，不用 latest。每月手动升级时才改这里
VW_VERSION=1.37.2

# 对内监听端口（只绑定 127.0.0.1，公网不可见）。没有特殊理由不要改
ROCKET_PORT=8222

# 是否允许注册新账号：
#   部署初期 = true，方便你把所有身份账号注册完；
#   全部注册完后改成 false（这是硬性要求），改完运行：
#   cd /opt/vaultwarden && docker compose up -d
SIGNUPS_ALLOWED=true

# 是否允许邀请别人。用不上，永远保持 false
INVITATIONS_ALLOWED=false

# 管理后台令牌：留空 = 彻底关闭 /admin 管理后台（推荐，保持留空）
ADMIN_TOKEN=

# ---------- 备份 ----------

# age 公钥（一串以 age1 开头的字符）。服务器只存公钥用来加密备份；
# 私钥永远不要放到服务器上！私钥离线保存（打印 / U 盘）
AGE_PUBLIC_KEY=

# 备份包在本服务器的存放目录（修改本项后需重跑 sudo bash setup.sh 才生效）
BACKUP_DIR=/var/backups/vaultwarden

# 本地保留最近多少天的备份
RETENTION_DAYS=30

# 异地备份目标（另一台服务器，经 Tailscale + rrsync 只写限制），格式：用户@主机:.
# 例：backupstore@100.64.0.5:.
# 注意：末尾的 ":." 表示 rrsync 受限目录本身，不要写绝对路径（配置方法见安装指南 §10）
# 留空 = 暂不同步异地（只存本机）
OFFSITE_TARGET=

# 异地同步用的 SSH 私钥路径（生成方法见安装指南第 10 节）
OFFSITE_SSH_KEY=/root/.ssh/vw_offsite
